# 논점(nonjeom) 환경변수. 값은 넣지 말고 이름과 설명만 둔다. 로컬에서는 이 파일을 .env로 복사해 값을 채운다(.env는 커밋 금지).
# GitHub Actions에서는 Settings → Secrets and variables → Actions 에 같은 이름으로 등록한다.

# ── 비밀값(Secrets) ──
# Google Gemini API 키(필수, 기본 무료 등급). https://aistudio.google.com 에서 발급.
# 결제가 연결되지 않은 Google 프로젝트에서 만든 키여야 요금이 나가지 않는다.
GEMINI_API_KEY=
# (선택, 유료) Anthropic 모델로 바꿀 때만. config/models.json의 provider를 anthropic으로 변경.
ANTHROPIC_API_KEY=
# 내부 기록(미발행 초안·검토 원문·수집 기록) 암호화 키. 24자 이상 임의 문자열. 예: openssl rand -base64 32
# 분실하면 이전 내부 기록을 읽을 수 없다(발행물은 영향 없음).
NJ_INTERNAL_KEY=
# (선택) 검토 역할을 다른 회사 모델로 분리할 때만. NJ_REVIEWER_PROVIDER=openai, NJ_REVIEWER_MODEL=<공식 문서에서 확인한 모델명>
OPENAI_API_KEY=

# ── 설정(Variables, 선택) ──
# 사이트 이름 변경
NJ_SITE_NAME=
# 하루 발행 목표 개수(최소·최대). 기준 미달 주제로 채우지 않는다.
NJ_TOPICS_MIN=
NJ_TOPICS_MAX=
# 모범답안 분량(공백 포함, 줄바꿈 제외)
NJ_ANSWER_MIN_CHARS=
NJ_ANSWER_MAX_CHARS=
# 하루 LLM 호출 상한(무료 등급 운영용, 기본 60). 도달하면 검토를 생략하지 않고 새 주제 작성을 보류한다.
NJ_DAILY_CALL_CAP=
# 특정 Gemini 모델로 고정(비우면 실행 시 사용 가능 목록에서 자동 선택)
NJ_GEMINI_MODEL=
# Gemini 호출 사이 최소 간격(ms, 기본 13000) — 분당 무료 한도 대응
NJ_GEMINI_MIN_INTERVAL_MS=
# 일일 비용 상한(USD, 유료 모델을 쓸 때 적용). 도달하면 검토를 생략하지 않고 새 주제 작성을 보류한다.
NJ_DAILY_USD_CAP=
# 수정 반복 상한
NJ_MAX_REVISIONS=
# 동시에 처리할 주제 수
NJ_TOPIC_CONCURRENCY=
# 예약 실행 일시 중지(true). 수동 실행은 계속 가능.
NJ_PAUSED=
# 역할별 제공자·모델 덮어쓰기(triage, facts, writer, reviewer). 예: NJ_REVIEWER_PROVIDER=openai
NJ_WRITER_PROVIDER=
NJ_WRITER_MODEL=
NJ_REVIEWER_PROVIDER=
NJ_REVIEWER_MODEL=
# OpenAI 모델 단가(USD/백만 토큰). 지정하지 않으면 비용 추정 없이 토큰 상한만 적용된다.
NJ_OPENAI_PRICE_IN=
NJ_OPENAI_PRICE_OUT=
